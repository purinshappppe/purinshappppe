<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>リコピンだいすき♡</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
      background: linear-gradient(135deg, #ffeef5, #fff8fb);
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
    }

    .container {
      width: min(900px, 92%);
      padding: 45px 30px;
      text-align: center;
      background: rgba(255, 255, 255, 0.8);
      border-radius: 35px;
      box-shadow: 0 15px 50px rgba(220, 130, 160, 0.18);
      border: 2px solid #ffd6e3;
      position: relative;
    }

    /* ハート */
    .heart {
      position: absolute;
      font-size: 35px;
      animation: float 3s ease-in-out infinite;
    }

    .heart1 {
      top: 25px;
      left: 45px;
    }

    .heart2 {
      top: 45px;
      right: 50px;
      animation-delay: 0.8s;
    }

    .heart3 {
      bottom: 30px;
      left: 70px;
      animation-delay: 1.4s;
    }

    .heart4 {
      bottom: 45px;
      right: 70px;
      animation-delay: 2s;
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0) rotate(-5deg);
      }

      50% {
        transform: translateY(-12px) rotate(5deg);
      }
    }

    .small-title {
      color: #d98aa5;
      font-size: 18px;
      letter-spacing: 5px;
      margin-bottom: 10px;
    }

    h1 {
      margin: 0;
      font-size: clamp(45px, 8vw, 80px);
      color: #d95b83;
      letter-spacing: 3px;
      text-shadow: 3px 4px 0 #ffe0ea;
    }

    .subtitle {
      margin: 15px 0 30px;
      color: #9d6879;
      font-size: 18px;
    }

    /* 写真 */
    .photo-area {
      width: min(600px, 100%);
      margin: auto;
    }

    .photo-frame {
      width: 100%;
      aspect-ratio: 16 / 10;
      border-radius: 25px;
      border: 4px dashed #f3a9bf;
      background: #fff4f8;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      position: relative;
      cursor: pointer;
      transition: 0.3s;
    }

    .photo-frame:hover {
      transform: scale(1.015);
      background: #ffedf4;
    }

    #preview {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
    }

    .placeholder {
      color: #d38ba3;
      font-size: 18px;
    }

    .placeholder span {
      display: block;
      font-size: 55px;
      margin-bottom: 10px;
    }

    input[type="file"] {
      display: none;
    }

    .button {
      display: inline-block;
      margin-top: 20px;
      padding: 13px 30px;
      border-radius: 999px;
      background: #e986a6;
      color: white;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 7px 18px rgba(220, 120, 150, 0.25);
      transition: 0.2s;
    }

    .button:hover {
      transform: translateY(-3px);
      background: #dc6f93;
    }

    .message {
      margin-top: 30px;
      color: #b06c82;
      font-size: 17px;
      line-height: 1.8;
    }

    .love {
      margin-top: 18px;
      font-size: 28px;
      color: #e8799b;
      letter-spacing: 8px;
    }

    /* スマホ */
    @media (max-width: 600px) {
      .container {
        padding: 35px 18px;
      }

      .small-title {
        font-size: 14px;
      }

      .subtitle {
        font-size: 15px;
      }

      .heart {
        font-size: 25px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="heart heart1">♡</div>
    <div class="heart heart2">♡</div>
    <div class="heart heart3">♡</div>
    <div class="heart heart4">♡</div>

    <div class="small-title">
      FOR RIKO
    </div>

    <h1>リコピン<br>だいすき♡</h1>

    <div class="subtitle">
      世界でいちばん大切なリコへ
    </div>

    <div class="photo-area">

      <label class="photo-frame" for="photoInput">

        <div class="placeholder" id="placeholder">
          <span>📷</span>
          写真を選んでね♡
        </div>

        <img id="preview" alt="リコの写真">

      </label>

      <input
        type="file"
        id="photoInput"
        accept="image/*"
      >

      <label class="button" for="photoInput">
        📸 写真を選ぶ
      </label>

    </div>

    <div class="message">
      リコが笑ってるだけで幸せ♡<br>
      これからもずっと一緒にいようね。
    </div>

    <div class="love">
      ♡　♡　♡
    </div>

  </div>

  <script>
    const photoInput = document.getElementById("photoInput");
    const preview = document.getElementById("preview");
    const placeholder = document.getElementById("placeholder");

    photoInput.addEventListener("change", function () {

      const file = this.files[0];

      if (!file) return;

      const reader = new FileReader();

      reader.onload = function (e) {
        preview.src = e.target.result;
        preview.style.display = "block";
        placeholder.style.display = "none";
      };

      reader.readAsDataURL(file);
    });
  </script>

</body>
</html>
